    "framer-motion": "^10.12.18",
    "input-otp": "^1.2.4",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.252.0",
    "next": "13.4.7",
    "next-themes": "^0.3.0",
    "postcss": "8.4.24",
    "react": "18.2.0",
    "react-day-picker": "^8.8.0",
    "react-dom": "18.2.0",
    "react-hook-form": "^7.51.5",
