{
  "name": "adora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "tsc": "tsc",
    "db:generate": "dotenv drizzle-kit generate",
    "db:introspect": "dotenv drizzle-kit introspect",
    "db:push": "dotenv drizzle-kit push",
    "db:migrate": "dotenv cross-env DB_MIGRATING=true tsx src/db/migrate.ts",
    "db:reset": "dotenv tsx src/db/reset.ts",
    "db:drop-migration": "drizzle-kit drop",
    "db:seed": "dotenv cross-env DB_SEEDING=true tsx src/db/seed.ts",
    "db:studio": "dotenv drizzle-kit studio --config=drizzle.config.ts",
    "prepare": "husky install",
    "lint": "eslint --ignore-path .gitignore --cache --ext .js,.ts,.tsx . --fix  && prettier --write .",
    "lint:fix": "eslint --fix .",
    "postinstall": "husky install",
    "stripe:listen": "stripe listen --forward-to localhost:3001/api/webhooks/stripe --latest",
    "format": "prettier --config .prettierrc 'src/**/*.ts' --write"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@lucia-auth/adapter-drizzle": "^1.0.7",
    "@node-rs/argon2": "^1.8.3",
    "@node-rs/bcrypt": "^1.10.7",
    "@paralleldrive/cuid2": "^2.2.2",
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-aspect-ratio": "^1.0.3",
    "@radix-ui/react-avatar": "^1.0.3",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.5",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.1.3",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@react-email/components": "0.0.21",
    "@react-email/render": "^0.0.16",
    "@react-email/tailwind": "0.0.18",
    "@t3-oss/env-nextjs": "^0.10.1",
    "@tailwindcss/typography": "^0.5.9",
    "@tanstack/react-query": "^5.37.1",
    "@tanstack/react-query-devtools": "^5.37.1",
    "@tanstack/react-table": "^8.17.3",
    "@types/node": "20.3.1",
    "@types/react": "18.2.14",
    "@types/react-dom": "18.2.6",
    "@upstash/ratelimit": "^2.0.1",
    "@upstash/redis": "^1.33.0",
    "@vapi-ai/server-sdk": "^0.2.2",
    "@vapi-ai/web": "^2.1.7",
    "@vercel/speed-insights": "^1.1.0",
    "arctic": "^1.9.1",
    "autoprefixer": "10.4.14",
    "axios": "^1.7.6",
    "class-variance-authority": "^0.6.0",
    "clsx": "^1.2.1",
    "cmdk": "^1.0.0",
    "country-state-city": "^3.2.1",
    "date-fns": "^3.6.0",
    "dotenv-cli": "^7.4.2",
    "drizzle-kit": "^0.22.8",
    "drizzle-orm": "^0.31.2",
    "eslint": "8.43.0",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "eslint-config-next": "14.2.4",
    "framer-motion": "^10.12.18",
    "input-otp": "^1.2.4",
    "libphonenumber-js": "^1.11.4",
    "lucia": "^3.2.0",
    "lucide-react": "^0.252.0",
    "next": "14.2.4",
    "next-themes": "^0.3.0",
    "nextjs-toploader": "^1.6.12",
    "nodemailer": "^6.9.14",
    "oslo": "^1.2.1",
    "pg": "^8.12.0",
    "postcss": "8.4.24",
    "postgres": "^3.4.4",
    "react": "18.3.1",
    "react-day-picker": "^8.8.0",
    "react-dom": "18.3.1",
    "react-fast-marquee": "^1.6.5",
    "react-hook-form": "^7.51.5",
    "react-multi-carousel": "^2.8.5",
    "react-paginate": "^8.2.0",
    "react-phone-number-input": "^3.4.3",
    "react-tooltip": "^5.28.0",
    "resend": "^3.5.0",
    "server-only": "^0.0.1",
    "sonner": "^1.4.41",
    "stripe": "^15.8.0",
    "tailwind-merge": "^1.13.2",
    "tailwindcss": "3.3.2",
    "tailwindcss-animate": "^1.0.6",
    "typescript": "5.1.3",
    "zod": "^3.22.4",
    "zsa": "^0.5.0",
    "zsa-react-query": "^0.2.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@tanstack/eslint-plugin-query": "^5.35.6",
    "@types/nodemailer": "^6.4.15",
    "@types/pg": "^8.11.6",
    "@typescript-eslint/eslint-plugin": "^5.60.0",
    "cross-env": "^7.0.3",
    "crypto-browserify": "^3.12.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-security": "^1.7.1",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "eslint-plugin-sonarjs": "^0.19.0",
    "eslint-plugin-storybook": "^0.6.12",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.2",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.3.0",
    "tailwind-scrollbar": "^3.1.0",
    "tsx": "^4.16.2"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --config ./.prettierrc --write"
    ],
    "**/*.{css,scss,md,html,json}": [
      "prettier --config ./.prettierrc --write"
    ]
  }
}
